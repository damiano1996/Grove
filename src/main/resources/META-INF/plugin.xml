<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin require-restart="false">
    <id>com.github.damiano1996.jetbrains.grove</id>
    <name>Grove</name>
    <vendor email="damiano.derin@gmail.com">Damiano Derin</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.github.damiano1996.jetbrains.grove.service.SessionRegistryService"/>

        <postStartupActivity implementation="com.github.damiano1996.jetbrains.grove.startup.GroveProjectActivity"/>

        <toolWindow id="Grove" secondary="true"
                    anchor="right"
                    icon="com.github.damiano1996.jetbrains.grove.icons.GroveIcons.TOOL_WINDOW"
                    factoryClass="com.github.damiano1996.jetbrains.grove.toolwindow.GroveToolWindowFactory"/>

        <notificationGroup id="Grove Notifications" displayType="BALLOON"/>
    </extensions>

    <applicationListeners>
        <listener class="com.github.damiano1996.jetbrains.grove.startup.GroveProjectCloseListener"
                  topic="com.intellij.openapi.project.ProjectManagerListener"/>
    </applicationListeners>

    <actions>
        <action id="Grove.NewSession"
                class="com.github.damiano1996.jetbrains.grove.actions.NewSessionAction"
                text="New Grove Session..."
                description="Create a worktree, open it in a new window, and launch a claude terminal in it"/>
    </actions>
</idea-plugin>
